# Neon Auth — the "Auth URL" shown on your Neon project's Auth tab.
# Neon Auth is Better Auth under the hood, served from your project's own
# Neon endpoint — not a shared host, so no separate project ID / client key
# is needed.
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/your-database/auth

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
