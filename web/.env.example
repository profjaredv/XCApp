# Neon Auth (Stack) — all three from your Neon project's Auth tab.
# VITE_STACK_API_URL is the "Auth URL" shown there — Neon Auth serves its
# API from your project's own Neon endpoint, not the shared
# api.stack-auth.com host most Stack Auth docs/examples assume.
VITE_STACK_PROJECT_ID=your-stack-project-id
VITE_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-client-key
VITE_STACK_API_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/your-database/auth

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
