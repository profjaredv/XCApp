# Neon Auth. In production this MUST point at this app's own domain,
# proxied through the backend (see backend/lib/authProxy.js and
# NEON_AUTH_UPSTREAM_URL in backend/.env.example) — calling Neon's own
# <endpoint>.neonauth.*.aws.neon.tech host directly from the browser makes
# the session cookie cross-site, and Safari's Intelligent Tracking
# Prevention silently refuses to keep a cookie set that way, which is why
# sign-in worked everywhere except Safari/iPadOS.
#   Production: https://your-app-domain.com/api/auth-proxy
#   Local dev:  http://127.0.0.1:3001/api/auth-proxy   (routes through the
#               backend too, so Safari testing works locally as well; the
#               backend still needs NEON_AUTH_UPSTREAM_URL set to the real
#               "Auth URL" from your Neon project's Auth tab)
VITE_NEON_AUTH_URL=http://127.0.0.1:3001/api/auth-proxy

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
