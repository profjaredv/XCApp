# Copy to .env and fill in values
# MONGODB_URI="your_mongodb_connection_string"
COACH_UPGRADE_CODE="your_secret_coach_code"
# If using a service account JSON, set FIREBASE_SERVICE_ACCOUNT_JSON to its absolute path
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to the same path.

FIREBASE_PROJECT_ID=
# Absolute path to the service account json (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_APPLICATION_CREDENTIALS=
