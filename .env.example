# Copy to .env and fill in values

# Required — server.js refuses to start without these.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
NEON_AUTH_JWKS_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth/.well-known/jwks.json"

# Required for `prisma migrate` — a non-pooled connection to the same database.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

COACH_UPGRADE_CODE="your_secret_coach_code"

# Optional. Comma-separated email allowlist for platform super-admin
# (cross-team view/edit). Leave unset to disable entirely — matches
# nothing, no accounts are ever granted this by default.
SUPER_ADMIN_EMAILS="you@example.com"
