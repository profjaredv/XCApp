// XCApp database schema — Neon Postgres.
//
// Rebuilt from the application code and the ad hoc SQL fix files in
// supabase_migrations/ and supabase/migrations/ (there was no single
// source of truth for the old schema — see MIGRATION_STATUS.md).
//
// Deliberate cleanups made while rebuilding (see MIGRATION_STATUS.md for
// the full list):
//   - `season` is now Int everywhere (was a mix of text/int across tables).
//   - `grade` is now Int everywhere (was a mix of text/int across tables).
//   - Every team-scoped table has a real foreign key + index on team_id;
//     several of these existed only as application-level conventions before.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Explicit finish status, replacing the implicit `time > 0` convention
// scattered across ~12 query sites as the only signal that a result wasn't
// a real finish. That convention doesn't distinguish DNF from DNS from DQ,
// and nothing enforced it on new code — a query that forgot the filter
// would silently include non-finishes in an average. See Result.status.
enum ResultStatus {
  FINISHED
  DNF
  DNS
  DQ
}

// ---------------------------------------------------------------------------
// Auth & team membership
// ---------------------------------------------------------------------------

// Mirrors a Neon Auth (Stack) user by id. Neon Auth owns the identity/login
// record in its own `neon_auth.users_sync` table; this is our app-level
// profile row (role, team assignment) keyed on the same id.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  role      String   @default("athlete") // 'coach' | 'athlete'
  teamId    String?  @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team                    Team?                 @relation("TeamUsers", fields: [teamId], references: [id], onDelete: SetNull)
  coachedTeams            Team[]                @relation("TeamCoach")
  teamMemberships         TeamMember[]
  createdRaceSplits       RaceSplit[]           @relation("RaceSplitCreator")
  linkedAthlete           Athlete?              @relation("AthleteAccount")
  athleteClaims           AthleteClaim[]
  sentStaffInvites        StaffInvite[]         @relation("StaffInviteSender")
  guardianLinks           GuardianLink[]        @relation("GuardianAccount")
  resolvedGuardianLinks   GuardianLink[]        @relation("GuardianLinkResolver")
  ledGroups               GroupLeader[]
  createdPracticePlans    PracticePlan[]        @relation("PracticePlanCreator")
  createdWorkoutTemplates WorkoutTemplate[]     @relation("WorkoutTemplateCreator")
  updatedMeetEntries      MeetEntry[]           @relation("MeetEntryUpdater")
  equipmentCheckedOut     EquipmentAssignment[] @relation("EquipmentCheckedOutBy")
  equipmentReturned       EquipmentAssignment[] @relation("EquipmentReturnedBy")
  createdIntervalSessions IntervalSession[]     @relation("IntervalSessionCreator")
  createdTrainingLogs     TrainingLog[]         @relation("TrainingLogCreator")

  @@index([teamId])
  @@map("users")
}

model Team {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  coachUid        String   @map("coach_uid") @db.Uuid
  joinCode        String   @unique @map("join_code")
  athleticTeamId  String   @unique @map("athletic_team_id")
  importedSeasons Int[]    @default([]) @map("imported_seasons")
  currentSeason   Int?     @map("current_season")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  coach                  User                     @relation("TeamCoach", fields: [coachUid], references: [id])
  members                User[]                   @relation("TeamUsers")
  teamMembers            TeamMember[]
  athletes               Athlete[]
  races                  Race[]
  results                Result[]
  seasons                Season[]
  meetGroups             MeetGroup[]
  raceSplits             RaceSplit[]
  teamSeasonMetrics      TeamSeasonMetrics[]
  athleteSeasonMetrics   AthleteSeasonMetrics[]
  meetPerformanceMetrics MeetPerformanceMetrics[]
  athleteInvites         AthleteInvite[]
  athleteClaims          AthleteClaim[]
  staffInvites           StaffInvite[]
  groups                 Group[]
  practicePlans          PracticePlan[]
  workoutTemplates       WorkoutTemplate[]
  meets                  Meet[]
  equipment              Equipment[]
  intervalSessions       IntervalSession[]

  @@index([coachUid])
  @@map("teams")
}

// T1 (Team Management handoff): replaces the old free-text 'coach'|'athlete'
// role string, which couldn't express a volunteer coach or a coach scoped
// to specific groups. Ranked HEAD_COACH > COACH > VOLUNTEER_COACH > ATHLETE
// by authority, but requireRole (middleware/auth.js) checks against an
// explicit allowed-roles list per route rather than a numeric rank — every
// route that should accept "any real coach" lists both HEAD_COACH and
// COACH explicitly. VOLUNTEER_COACH's access is inherently group-scoped
// (see T2's Group/GroupLeader), not a blanket route-level grant, so it
// deliberately isn't folded into a "coach and above" shorthand here.
enum TeamRole {
  HEAD_COACH // full admin: roster, season config, staff management
  COACH // paid assistant: full athlete read/write, plans, meet entry
  VOLUNTEER_COACH // group-scoped: plans for their own groups only
  ATHLETE
}

// Team roster membership (distinct from `users.team_id`, which is a user's
// *current* team; this is the durable join-history record).
model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TeamRole
  // A former volunteer/staff member's row is deactivated rather than
  // deleted, so join history and past group-leader/plan-author references
  // stay intact. requireRole treats an inactive row as no access at all.
  active   Boolean  @default(true)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([teamId, role])
  @@index([userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Roster & results
// ---------------------------------------------------------------------------

model Athlete {
  id                String   @id @default(uuid()) @db.Uuid
  teamId            String   @map("team_id") @db.Uuid
  name              String
  gender            String? // 'M' | 'F'
  grade             Int? // 9-12
  graduationYear    Int?     @map("graduation_year")
  // The athlete's own Athletic.net profile link (path or full URL, as
  // scraped — not a parsed-out numeric id, since this codebase has no
  // confirmed evidence of that URL's internal structure to safely parse
  // one). Opaque but stable per athlete, unlike name: two "Jack Smith"s on
  // a 120-person roster get two different values here. Null until a scrape
  // captures it (Phase 2 step 5) or for an athlete Athletic.net has no page
  // for yet. Scrapers/routes match on this first when present, falling
  // back to name — see routes/teams.js.
  athleticAthleteId String?  @unique @map("athletic_athlete_id")
  // The link this app never had: which signed-in account, if any, this
  // roster entry belongs to. Null means unclaimed — either nobody has
  // signed up yet, or a claim is still pending coach approval. Set only by
  // an accepted AthleteInvite or an approved AthleteClaim, never directly.
  userId            String?  @unique @map("user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  team                   Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                   User?                    @relation("AthleteAccount", fields: [userId], references: [id], onDelete: SetNull)
  results                Result[]
  raceSplits             RaceSplit[]
  seasonRosterEntries    SeasonRoster[]
  seasonMetrics          AthleteSeasonMetrics[]
  bestInMeets            MeetPerformanceMetrics[] @relation("BestAthlete")
  invite                 AthleteInvite?
  claims                 AthleteClaim[]
  trainingLogs           TrainingLog[]
  guardianLinks          GuardianLink[]
  groupMemberships       GroupMembership[]
  meetEntries            MeetEntry[]
  raceReflections        RaceReflection[]
  equipmentAssignments   EquipmentAssignment[]
  intervalSessionEntries IntervalSessionEntry[]

  // Relaxed from @@unique (Build Spec Phase 2 step 5): two students named
  // Jack Smith is a normal occurrence on a 120-person roster. Kept as a
  // plain index — lookups still filter by (teamId, name) constantly, it
  // just no longer rejects a second athlete with the same name.
  @@index([teamId, name])
  @@index([teamId])
  @@map("athletes")
}

// T1 (Team Management handoff), open question 2: "does any parent need to
// see meet logistics, entry status, or uniform obligations?" — resolved:
// yes, read-only, scoped to their own child. A stranger asserting "this is
// my kid" is exactly the AthleteClaim situation (unverified identity
// matching itself to a roster row), so this mirrors that model's
// pending/approved/rejected coach-gated flow rather than granting access
// on request. Read-only by design: nothing in this app writes through a
// GuardianLink, ever — see routes/guardian.js.
model GuardianLink {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  athleteId    String    @map("athlete_id") @db.Uuid
  status       String    @default("pending") // pending | approved | rejected
  requestedAt  DateTime  @default(now()) @map("requested_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by") @db.Uuid

  user       User    @relation("GuardianAccount", fields: [userId], references: [id], onDelete: Cascade)
  athlete    Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("GuardianLinkResolver", fields: [resolvedById], references: [id])

  @@unique([userId, athleteId])
  @@index([athleteId, status])
  @@map("guardian_links")
}

// A coach-initiated invite for a SPECIFIC athlete row. The coach already
// knows who this is; accepting the invite token is itself the approval, no
// separate review step. One row per athlete (re-inviting overwrites the
// token rather than accumulating history) — resending is meant to feel like
// "send it again," not a new request.
model AthleteInvite {
  id         String    @id @default(uuid()) @db.Uuid
  athleteId  String    @unique @map("athlete_id") @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  email      String
  token      String    @unique @default(uuid())
  status     String    @default("pending") // pending | accepted | revoked
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")
  expiresAt  DateTime  @map("expires_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("athlete_invites")
}

// A self-serve claim: an athlete joined via the team's join code (so team
// membership is already established) and is now asserting "this roster row
// is me." Unlike AthleteInvite, the coach didn't pick this athlete — a
// person of unverified identity is matching themselves to a name on the
// roster — so this DOES need a pending/approve step before it grants
// access to that athlete's record.
model AthleteClaim {
  id          String    @id @default(uuid()) @db.Uuid
  athleteId   String    @map("athlete_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  status      String    @default("pending") // pending | approved | rejected
  matchScore  Int?      @map("match_score")
  requestedAt DateTime  @default(now()) @map("requested_at")
  resolvedAt  DateTime? @map("resolved_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([athleteId, userId])
  @@index([teamId, status])
  @@map("athlete_claims")
}

// T1 (Team Management handoff): "Retire POST /api/profile/upgrade-to-coach
// in favor of head-coach-issued invites." Structurally parallel to
// AthleteInvite (token, pending/accepted/revoked, one row per invitee that
// re-inviting overwrites rather than accumulates) but a genuinely different
// concern — this grants team authority to an account, it doesn't link a
// roster row — so it's its own model rather than overloading AthleteInvite
// with a nullable athleteId and a role field that would only apply half
// the time.
model StaffInvite {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  email       String
  role        TeamRole // HEAD_COACH | COACH | VOLUNTEER_COACH — never ATHLETE, that's AthleteInvite's job
  token       String    @unique @default(uuid())
  status      String    @default("pending") // pending | accepted | revoked
  invitedById String    @map("invited_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  acceptedAt  DateTime? @map("accepted_at")
  expiresAt   DateTime  @map("expires_at")

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation("StaffInviteSender", fields: [invitedById], references: [id])

  @@unique([teamId, email])
  @@index([teamId])
  @@map("staff_invites")
}

// A self-reported training effort — deliberately NOT a Result. Results
// belong to a scraped Race with a team-wide meet context (place, official
// time, feeds team/meet metrics); a training log is personal, unverified,
// and must never be able to corrupt race history or team aggregates.
model TrainingLog {
  id          String   @id @default(uuid()) @db.Uuid
  athleteId   String   @map("athlete_id") @db.Uuid
  date        DateTime @db.Date
  type        String // easy | tempo | interval | long | race_adjacent | other
  distanceMi  Float?   @map("distance_mi")
  durationSec Int?     @map("duration_sec")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Set only when a coach's IntervalSession entry wrote this row (T6 item
  // 6: coach-recorded reps get logged back to the athlete). Every other
  // TrainingLog is athlete-self-reported, per this model's own comment
  // above, so createdById stays null for those — this is the one
  // deliberate exception, not a general coach-authorship field.
  createdById                  String? @map("created_by") @db.Uuid
  sourceIntervalSessionEntryId String? @unique @map("source_interval_session_entry_id") @db.Uuid
  // [{ rep: 1, seconds: 185 }, ...] — only ever set alongside
  // sourceIntervalSessionEntryId; a plain self-reported log has no splits.
  repSplits                    Json?   @map("rep_splits")

  athlete                    Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy                  User?                 @relation("TrainingLogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceIntervalSessionEntry IntervalSessionEntry? @relation(fields: [sourceIntervalSessionEntryId], references: [id], onDelete: SetNull)

  @@index([athleteId, date])
  @@map("training_logs")
}

// T5 (Team Management handoff): "the most emotionally valuable thing in
// the app and the most sensitive." Pre-race fields (processGoal through
// keyFocus) lock server-side once the race has started — see
// lib/raceReflections.js's computeLockAt/isPreRaceLocked, enforced in
// routes/raceReflections.js, never just hidden client-side. Post-race
// fields never lock. `targetSplits` is the athlete's own pre-race plan,
// distinct from RaceSplit (a coach's transcription of what actually
// happened) — neither one writes to the other; they only meet as a
// target-vs-actual comparison on the athlete's own race page.
// `sharedWithCoach` defaults true (matching paper, where handing over the
// sheet was the default) and is enforced as a query-layer filter
// (decideCanViewReflection), never a component-level hide — see that
// function's own comment for the exact allowlist, including that a
// captain (a TeamRole.ATHLETE, same as any other athlete) never sees
// this endpoint at all, let alone another athlete's row.
model RaceReflection {
  id        String @id @default(uuid()) @db.Uuid
  athleteId String @map("athlete_id") @db.Uuid
  raceId    String @map("race_id") @db.Uuid

  // Pre-race, locks at race start
  processGoal    String?   @map("process_goal") // "stay relaxed through mile 1"
  outcomeGoal    String?   @map("outcome_goal") // "top 20", "sub 18"
  targetTimeSec  Float?    @map("target_time_sec")
  targetSplits   Json?     @map("target_splits") // [{ markerMeters, elapsedSec }]
  keyFocus       String?   @map("key_focus")
  preSubmittedAt DateTime? @map("pre_submitted_at")

  // Post-race
  feelingRating   Int?      @map("feeling_rating") // 1-10
  effortRating    Int?      @map("effort_rating") // 1-10
  whatWorked      String?   @map("what_worked")
  whatDidnt       String?   @map("what_didnt")
  postNotes       String?   @map("post_notes")
  postSubmittedAt DateTime? @map("post_submitted_at")

  sharedWithCoach Boolean @default(true) @map("shared_with_coach")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race    Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([athleteId, raceId])
  @@map("race_reflections")
}

// ---------------------------------------------------------------------------
// T4 (Team Management handoff): meet operations. "A meet contains several
// races: boys varsity, girls varsity, boys JV, girls JV. Logistics attach
// to the meet; entry status attaches to the race." The pre-existing
// routes/meets.js ("GET /api/meets") is unrelated to this model despite
// the name clash — it's a legacy analytics endpoint that treats each Race
// row as its own "meet" (the exact "Race but no parent" gap this section
// fills), predating this entity, and is left alone here since fixing that
// naming isn't in scope. This model's own routes are deliberately mounted
// under a different path (routes/meetOps.js -> /api/meet-ops) to avoid
// colliding with it. Race<->Meet grouping for existing scraped data is
// never automatic (name+date similarity only proposes a mapping — see
// scripts/proposeMeetMapping.js/applyMeetMapping.js, same
// propose/coach-confirms/apply shape as Course mapping in the analytics
// track); every Race created going forward can set meetId directly.
model Meet {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  seasonId       String   @map("season_id") @db.Uuid
  name           String
  date           DateTime @db.Date
  location       String?
  sourceUrl      String?  @map("source_url") // Athletic.net meet page
  // Athletic.net's own meet ID — same value Race.athleticMeetId stores from
  // results scraping. Nullable (a coach can hand-create a Meet with no
  // Athletic.net counterpart) but the dedup key when one exists: importing
  // the team's calendar feed twice, or importing the calendar then later
  // scraping results for the same meet, must land on one Meet row, not two.
  // Postgres treats NULLs as distinct in a unique index, so hand-created
  // rows never collide with each other here.
  athleticMeetId String?  @map("athletic_meet_id")

  team   Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  races  Race[]
  plan   MeetPlan?

  @@unique([teamId, seasonId, athleticMeetId])
  @@index([seasonId, date])
  @@map("meets")
}

// Deliberately meet-level, not season-level: "am I entered, injured,
// scratched" changes per race, not once for the whole season, and
// ACADEMIC/EXCUSED status can differ meet to meet even for a healthy
// athlete. INJURED here is a scheduling flag only — "not racing this
// meet" — never a place to store medical detail (see the doc's open
// question 4: anything beyond that flag is a medical record this app
// isn't built to carry).
enum EntryStatus {
  ENTERED
  ALTERNATE
  NOT_ENTERED
  SCRATCHED
  INJURED
  ACADEMIC
  EXCUSED
}

model MeetEntry {
  id          String      @id @default(uuid()) @db.Uuid
  raceId      String      @map("race_id") @db.Uuid
  athleteId   String      @map("athlete_id") @db.Uuid
  status      EntryStatus @default(NOT_ENTERED)
  seedTimeSec Float?      @map("seed_time_sec")
  bibNumber   String?     @map("bib_number")
  notes       String?
  updatedById String?     @map("updated_by") @db.Uuid
  updatedAt   DateTime    @updatedAt @map("updated_at")

  race      Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("MeetEntryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([raceId, athleteId])
  @@index([raceId, status])
  @@map("meet_entries")
}

// Meet-day logistics — one row per Meet, not per race, since the bus and
// uniform are the same regardless of which race an athlete runs.
// `itinerary` is a free-form ordered list ([{ time, label }]) rather than
// its own table: it's always read/written as a whole unit on one screen,
// never queried by a single entry, so a table+FK would only add joins
// with no real query this app performs.
model MeetPlan {
  id             String    @id @default(uuid()) @db.Uuid
  meetId         String    @unique @map("meet_id") @db.Uuid
  departureTime  DateTime? @map("departure_time")
  returnTime     DateTime? @map("return_time")
  departureLoc   String?   @map("departure_location")
  transportNotes String?   @map("transport_notes")
  uniformNotes   String?   @map("uniform_notes")
  bringList      String?   @map("bring_list")
  itinerary      Json? // [{ time, label }]
  published      Boolean   @default(false)

  meet Meet @relation(fields: [meetId], references: [id], onDelete: Cascade)

  @@map("meet_plans")
}

model Race {
  id                 String   @id @default(uuid()) @db.Uuid
  teamId             String   @map("team_id") @db.Uuid
  name               String
  date               DateTime @db.Date
  season             Int
  distance           String? // e.g. "5K", "5,000 Meters" (as scraped)
  distanceMeters     Float?   @map("distance_meters")
  location           String?
  // Populated by the season scraper's meet-key extraction (Phase 2). Points
  // at this race's own meet-results page on Athletic.net, which carries the
  // full field (every school, every athlete) — the season grid never does.
  // Null for races imported before this field existed, until re-scraped.
  sourceUrl          String?  @map("source_url")
  athleticMeetId     String?  @map("athletic_meet_id")
  // T4: the parent Meet this race belongs to (boys varsity, girls JV, etc.
  // all sharing one meet day). Null until grouped — see the Meet model's
  // own comment for how existing scraped races get backfilled.
  meetId             String?  @map("meet_id") @db.Uuid
  // Set only by the coach-confirmed course-mapping apply step (see
  // scripts/proposeCourseMapping.js / scripts/applyCourseMapping.js) —
  // never inferred/written automatically from location-string similarity.
  courseId           String?  @map("course_id") @db.Uuid
  // Field-relative normalization (Build Spec, "Core measurement decisions").
  // Computed from FieldResult by the meet scraper's ingest step, gender-
  // specific — a single Athletic.net race entry is usually single-gender;
  // if one ever isn't, it gets split into two Race rows rather than storing
  // a blended figure here. Null (not zero) when normalization wasn't
  // computed — either the field scrape hasn't run for this race yet, or
  // fieldFinisherCount fell below the 40-finisher confidence threshold.
  fieldMeanSec       Float?   @map("field_mean_sec")
  fieldMedianSec     Float?   @map("field_median_sec")
  fieldFinisherCount Int?     @map("field_finisher_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  team                   Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  course                 Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  meet                   Meet?                    @relation(fields: [meetId], references: [id], onDelete: SetNull)
  results                Result[]
  raceSplits             RaceSplit[]
  meetGroupRaces         MeetGroupRace[]
  meetPerformanceMetrics MeetPerformanceMetrics[]
  fieldResults           FieldResult[]
  meetEntries            MeetEntry[]
  raceReflections        RaceReflection[]
  bestPaceForAthletes    AthleteSeasonMetrics[]   @relation("BestPaceRace")
  bestTime5kForAthletes  AthleteSeasonMetrics[]   @relation("BestTime5kRace")

  @@unique([teamId, name, date, distance])
  @@index([teamId])
  @@index([teamId, season])
  @@index([athleticMeetId])
  @@index([courseId])
  @@index([meetId])
  @@map("races")
}

// Every finisher (every school) in a race we scraped for field
// normalization — the FIELD side of the app. Used two ways: (1) to compute
// Race.fieldMeanSec/fieldMedianSec/fieldFinisherCount, and (2) name-matched
// against our own roster (lib/fieldPlacement.js) to set Result.division/
// place/overallPlace for our own athletes. It is never surfaced as a
// roster, never linked to a User or Athlete, and must never be exposed
// through an endpoint that returns individually-named rows for athletes
// outside the requesting team — aggregate reads only, or a match already
// folded into one of OUR OWN Result rows. If a route ever needs to expose
// per-athlete field data for another school, that is a new, deliberate
// product decision, not a query this table's existing shape implicitly
// permits.
model FieldResult {
  id          String  @id @default(uuid()) @db.Uuid
  raceId      String  @map("race_id") @db.Uuid
  athleteName String  @map("athlete_name")
  schoolName  String? @map("school_name")
  gender      String?
  // The division/heat text this row's own results page reported it under
  // (e.g. "5,000 Meters Boys Gold Varsity") — see fieldResultsBookmarklet.ts.
  // Multiple divisions legitimately coexist for one raceId now (that's the
  // whole point: Race stays scoped to distance only, not gender/division),
  // so this is what a re-upload's delete-before-recreate scopes itself to —
  // see routes/fieldResults.js — instead of wiping the whole race's field.
  division    String?
  grade       Int?
  timeSec     Float?  @map("time_sec")
  place       Int?
  status      String  @default("FINISHED")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId])
  @@map("field_results")
}

// A physical race venue, shared across teams and seasons — deliberately NOT
// team-scoped. Two teams racing at Franklin Park are on the same course, and
// that shared identity is what makes cross-team field normalization
// meaningful later. Replaces the free-text Race.location / manual MeetGroup
// workaround for cross-season comparison (Build Spec Phase 2). Course rows
// and Race.courseId links are only ever created by a coach-confirmed mapping
// (scripts/applyCourseMapping.js) — never auto-merged on string similarity.
model Course {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  city           String?
  state          String?
  distanceMeters Float?   @map("distance_meters")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  races Race[]

  @@unique([name, city, state])
  @@map("courses")
}

model Result {
  id               String       @id @default(uuid()) @db.Uuid
  raceId           String       @map("race_id") @db.Uuid
  athleteId        String       @map("athlete_id") @db.Uuid
  teamId           String       @map("team_id") @db.Uuid
  time             Float? // seconds
  // ORIGIN (the season scraper) owns time/grade/status — the official
  // record. FIELD (a field-results upload) owns everything below: which
  // division this athlete actually ran, matched by name against that same
  // Race's FieldResult rows (lib/fieldPlacement.js). Race itself deliberately
  // stays scoped to just (team, meet, distance) as ORIGIN already creates it
  // — it does NOT split by gender or division; one Race can and does hold
  // both Boys and Girls, and every ability-tiered heat (Gold/Silver/Bronze
  // Varsity, JV Freshman/Sophomore/...) of that distance. Splitting by
  // gender/division happens here, per-Result, not by fragmenting Race.
  //
  // division: the division/heat text this athlete actually raced, e.g.
  // "5,000 Meters Boys Gold Varsity" — lets views group/filter by it.
  division         String?
  // place: this athlete's place within their own division's field, read
  // straight from the matched FieldResult row's own place.
  // overallPlace/overallFieldSize: combined rank across every division in
  // this SAME race sharing this athlete's gender (FieldResult.gender), by
  // time — "where would this result have placed against the whole
  // same-gender field, not just this one heat." Only set when that gender
  // actually has 2+ distinct divisions in the race; one heat has nothing
  // "overall" to distinguish from "place" and leaves this null.
  //
  // All three are null until a field-results upload exists for this race —
  // recomputed by lib/fieldPlacement.js whenever it changes. Not the same
  // thing as "team place" (this athlete's rank among just our own team's
  // finishers, same gender) — that's ORIGIN-only, always available, and
  // computed on read (lib/teamPlace.js), never stored here.
  place            Int?
  overallPlace     Int?         @map("overall_place")
  overallFieldSize Int?         @map("overall_field_size")
  grade            Int? // athlete's grade at the time of this specific race
  status           ResultStatus @default(FINISHED)
  createdAt        DateTime     @default(now()) @map("created_at")

  race      Race       @relation(fields: [raceId], references: [id], onDelete: Cascade)
  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  raceSplit RaceSplit?

  @@unique([athleteId, raceId])
  @@index([raceId])
  @@index([athleteId])
  @@index([teamId])
  @@map("results")
}

model RaceSplit {
  id          String   @id @default(uuid()) @db.Uuid
  resultId    String   @unique @map("result_id") @db.Uuid
  athleteId   String   @map("athlete_id") @db.Uuid
  raceId      String   @map("race_id") @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  mile1       Float?   @map("mile_1")
  mile2       Float?   @map("mile_2")
  mile3       Float?   @map("mile_3")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by") @db.Uuid

  result    Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race      Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("RaceSplitCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([athleteId])
  @@index([raceId])
  @@index([teamId])
  @@map("race_splits")
}

// ---------------------------------------------------------------------------
// Seasons
// ---------------------------------------------------------------------------

model Season {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  year      Int
  sport     String    @default("XC")
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roster               SeasonRoster[]
  groups               Group[]
  practicePlans        PracticePlan[]
  meets                Meet[]
  equipmentAssignments EquipmentAssignment[]
  intervalSessions     IntervalSession[]

  @@unique([teamId, year, sport])
  @@index([teamId])
  @@map("seasons")
}

model SeasonRoster {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  athleteId String   @map("athlete_id") @db.Uuid
  grade     Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Set by a roster sync (see routes/teams.js POST /scrape-roster) when this
  // athlete was active but no longer appears on Athletic.net's roster. This
  // is a coach-reviewable signal, never an automatic deactivation — a sync
  // must never be able to silently remove someone from the app's roster.
  flaggedForRemoval   Boolean   @default(false) @map("flagged_for_removal")
  flaggedForRemovalAt DateTime? @map("flagged_for_removal_at")

  // T1: captaincy is annual — a captain is still an athlete who trains and
  // races, so this lives on the per-season roster row (not Athlete, not a
  // TeamRole) and its history is preserved automatically across seasons.
  // Being a captain grants NO extra data access by itself; that's entirely
  // a function of GroupLeader once T2's groups exist. A captain who leads
  // no group sees exactly what any other athlete sees.
  isCaptain    Boolean @default(false) @map("is_captain")
  captainNotes String? @map("captain_notes")

  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([seasonId, athleteId])
  @@index([seasonId])
  @@index([athleteId])
  @@map("season_roster")
}

// ---------------------------------------------------------------------------
// T2 (Team Management handoff): training groups, captain groups, and any
// future grouping are the same shape — one model, not three, per the doc's
// own instruction ("three tables means three assignment screens and three
// copies of the same bug").
// ---------------------------------------------------------------------------

enum GroupType {
  TRAINING // coach-led, ability-based, gender-split
  CAPTAIN // captain-led
  CUSTOM
}

model Group {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  seasonId  String    @map("season_id") @db.Uuid
  name      String // "Boys Blue", "Girls Group 2"
  type      GroupType
  gender    String? // "M" | "F" | null for mixed
  sortOrder Int       @default(0) @map("sort_order") // display order, fastest first
  color     String?
  archived  Boolean   @default(false)

  team             Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season           Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  memberships      GroupMembership[]
  leaders          GroupLeader[]
  planAssignments  PracticePlanAssignment[]
  intervalSessions IntervalSession[]

  @@unique([seasonId, name])
  @@index([teamId, seasonId])
  @@map("groups")
}

// A group may have several leaders (a paid coach plus a volunteer, or a
// coach plus a captain) — exactly one should be `primary`, enforced in
// application logic (routes/groups.js) with a validation error, not
// silently, since the DB can't express "exactly one true per groupId."
model GroupLeader {
  id      String  @id @default(uuid()) @db.Uuid
  groupId String  @map("group_id") @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  primary Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_leaders")
}

// Effective-dated on purpose: athletes move between training groups
// mid-season (that's the point of ability grouping), and a foreign key
// updated in place would erase the history of every previous assignment —
// which is exactly what lets analytics later segment race performance by
// the training group an athlete was actually in on a given date. Moving an
// athlete means closing this row (endDate) and opening a new one; NEVER
// update groupId in place on an existing row. See lib/groups.js's
// getGroupOn(athleteId, date) — the one place this table should ever be
// date-range-queried from; don't scatter that logic through routes.
model GroupMembership {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  athleteId String    @map("athlete_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date // null means current
  movedById String?   @map("moved_by") @db.Uuid
  reason    String?

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, startDate])
  @@index([groupId])
  @@map("group_memberships")
}

// ---------------------------------------------------------------------------
// T3 (Team Management handoff): practice plans. One day, several groups, a
// different assignment per group — this module owns training-plan creation.
// ---------------------------------------------------------------------------

// One row per (season, date) — a day's practice. `published` gates athlete
// visibility so a coach can draft Tuesday's plan on Sunday without athletes
// seeing half a workout (see routes/practicePlans.js).
model PracticePlan {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  seasonId    String   @map("season_id") @db.Uuid
  date        DateTime @db.Date
  title       String? // "Hill repeats", "Meet prep"
  teamNotes   String?  @map("team_notes") // applies to everyone
  location    String?
  startTime   String?  @map("start_time") // "15:30"
  published   Boolean  @default(false)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team        Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season      Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdBy   User?                    @relation("PracticePlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments PracticePlanAssignment[]

  @@unique([seasonId, date])
  @@index([seasonId, date])
  @@map("practice_plans")
}

// groupId null means team-wide (strength sessions, meetings). A copy of a
// WorkoutTemplate's fields at insertion time, never a reference — see
// WorkoutTemplate's own comment for why.
model PracticePlanAssignment {
  id              String  @id @default(uuid()) @db.Uuid
  practicePlanId  String  @map("practice_plan_id") @db.Uuid
  groupId         String? @map("group_id") @db.Uuid
  volumeTier      String? @map("volume_tier") // "low" | "medium" | "high" | "high_plus"
  focus           String? // "tempo", "long run", "recovery"
  durationMinutes Int?    @map("duration_minutes")
  distanceMi      Float?  @map("distance_mi")
  strength        Boolean @default(false)
  details         String? // the actual workout text
  sortOrder       Int     @default(0) @map("sort_order")

  practicePlan PracticePlan @relation(fields: [practicePlanId], references: [id], onDelete: Cascade)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([practicePlanId])
  @@map("practice_plan_assignments")
}

// Reusable workouts survive across seasons and get named ("Tempo Tuesday").
// NOT season-scoped — a workout that worked in 2024 should be one click
// away in 2027. Inserting one into a day COPIES its fields into a new
// PracticePlanAssignment; nothing ever references a template by id, so
// editing a template later can never retroactively change a plan that
// already used it.
model WorkoutTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @map("team_id") @db.Uuid
  name            String
  volumeTier      String?  @map("volume_tier")
  focus           String?
  durationMinutes Int?     @map("duration_minutes")
  distanceMi      Float?   @map("distance_mi")
  strength        Boolean  @default(false)
  details         String?
  archived        Boolean  @default(false)
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation("WorkoutTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([teamId, name])
  @@map("workout_templates")
}

// ---------------------------------------------------------------------------
// T6 item 6 (coach-adoption pass): coach-led interval/tempo capture. A
// coach's paper sheet for "5 x 800" has one row per athlete with a fixed
// set of time blanks; this is that sheet, not a PracticePlanAssignment
// (which describes what a group *should* do, not what each athlete
// actually ran). Saving writes each entry back to that athlete's
// TrainingLog — see TrainingLog.sourceIntervalSessionEntryId.
// ---------------------------------------------------------------------------

model IntervalSession {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  seasonId String   @map("season_id") @db.Uuid
  // Null for an ad hoc combined/all-comers session — a coach can run one
  // of these without it belonging to any single training Group.
  groupId  String?  @map("group_id") @db.Uuid
  date     DateTime @db.Date
  title    String // "5 x 800m Tempo"

  // Repeat distance + VDOT zone this session's suggested paces are pulled
  // from (TrainingPaceZone['key'] in vdotPaces.ts: threshold | interval |
  // repetition — the only zones with meaningful repeat splits). Suggested
  // times are computed client-side from each athlete's own VDOT, not
  // stored here.
  repDistanceM Int    @map("rep_distance_m")
  zone         String

  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team      Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season                 @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group     Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User?                  @relation("IntervalSessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries   IntervalSessionEntry[]

  @@index([teamId, seasonId, date])
  @@map("interval_sessions")
}

// Six fixed rep-time columns rather than a normalized reps table — the
// user's own call: "should be fixed... for simplicity, having all 6
// listed." A low-volume athlete just leaves rep4-6 blank; the grid always
// shows all 6.
model IntervalSessionEntry {
  id                String  @id @default(uuid()) @db.Uuid
  intervalSessionId String  @map("interval_session_id") @db.Uuid
  athleteId         String  @map("athlete_id") @db.Uuid
  // True when this athlete isn't a member of the session's group (or the
  // session has no group) — "sometimes that happens" per the request.
  addedManually     Boolean @default(false) @map("added_manually")
  rep1              Float?
  rep2              Float?
  rep3              Float?
  rep4              Float?
  rep5              Float?
  rep6              Float?
  notes             String?

  intervalSession IntervalSession @relation(fields: [intervalSessionId], references: [id], onDelete: Cascade)
  athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainingLog     TrainingLog?

  @@unique([intervalSessionId, athleteId])
  @@map("interval_session_entries")
}

// ---------------------------------------------------------------------------
// Manual meet grouping (cross-season comparisons)
// ---------------------------------------------------------------------------

model MeetGroup {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  groupName   String   @map("group_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  races MeetGroupRace[]

  @@unique([teamId, groupName])
  @@index([teamId])
  @@map("meet_groups")
}

model MeetGroupRace {
  id          String   @id @default(uuid()) @db.Uuid
  meetGroupId String   @map("meet_group_id") @db.Uuid
  raceId      String   @map("race_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  meetGroup MeetGroup @relation(fields: [meetGroupId], references: [id], onDelete: Cascade)
  race      Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([meetGroupId, raceId])
  @@index([meetGroupId])
  @@index([raceId])
  @@map("meet_group_races")
}

// ---------------------------------------------------------------------------
// Pre-calculated analytics (written by the calculation service, read by the
// analytics/performance routes — never written to directly by user input)
// ---------------------------------------------------------------------------

model TeamSeasonMetrics {
  id                 String   @id @default(uuid()) @db.Uuid
  teamId             String   @map("team_id") @db.Uuid
  season             Int
  athleteCount       Int?     @map("athlete_count")
  maleAthleteCount   Int?     @map("male_athlete_count")
  femaleAthleteCount Int?     @map("female_athlete_count")
  meetCount          Int?     @map("meet_count")
  totalRaces         Int?     @map("total_races")
  totalMiles         Float?   @map("total_miles")
  averagePace        Float?   @map("average_pace")
  improvementPercent Float?   @map("improvement_percent")
  firstMeet          Json?    @map("first_meet")
  lastMeet           Json?    @map("last_meet")
  byGender           Json?    @map("by_gender")
  byGrade            Json?    @map("by_grade")
  // Cross-tab of byGrade x byGender ({ grade9: { M: GroupStats, F: GroupStats }, ... })
  // — the dashboard's "average pace by grade+gender+count" view. Same
  // _calculateGroupStats shape as byGender/byGrade, just split both ways.
  byGradeGender      Json?    @map("by_grade_gender")
  byDistance         Json?    @map("by_distance")
  teamDepth          Json?    @map("team_depth")
  packRunning        Json?    @map("pack_running")
  // Team scoring/field-standing, computed from field-results uploads (see
  // lib/meetScoring.js) — { avgTeamScore, scoredDivisionCount, top20Percent,
  // top50Percent, totalWithFieldData }. Null fields (not the JSON as a
  // whole) when no field-results upload exists for any race this season.
  fieldStanding      Json?    @map("field_standing")
  calculatedAt       DateTime @default(now()) @map("calculated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, season])
  @@index([teamId])
  @@map("team_season_metrics")
}

model AthleteSeasonMetrics {
  id                 String   @id @default(uuid()) @db.Uuid
  athleteId          String   @map("athlete_id") @db.Uuid
  teamId             String   @map("team_id") @db.Uuid
  season             Int
  name               String? // denormalized snapshot
  gender             String?
  grade              Int?
  totalRaces         Int?     @map("total_races")
  totalMiles         Float?   @map("total_miles")
  totalTimeSeconds   Float?   @map("total_time_seconds")
  averagePace        Float?   @map("average_pace")
  bestPace           Float?   @map("best_pace")
  bestPaceRaceId     String?  @map("best_pace_race_id") @db.Uuid
  bestTime5k         Float?   @map("best_time_5k")
  bestTime5kRaceId   String?  @map("best_time_5k_race_id") @db.Uuid
  improvementPercent Float?   @map("improvement_percent")
  calculatedAt       DateTime @default(now()) @map("calculated_at")

  athlete        Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team           Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  bestPaceRace   Race?   @relation("BestPaceRace", fields: [bestPaceRaceId], references: [id], onDelete: SetNull)
  bestTime5kRace Race?   @relation("BestTime5kRace", fields: [bestTime5kRaceId], references: [id], onDelete: SetNull)

  @@unique([athleteId, teamId, season])
  @@index([teamId])
  @@index([athleteId])
  @@map("athlete_season_metrics")
}

model MeetPerformanceMetrics {
  id                     String    @id @default(uuid()) @db.Uuid
  raceId                 String    @map("race_id") @db.Uuid
  teamId                 String    @map("team_id") @db.Uuid
  season                 Int
  meetName               String?   @map("meet_name")
  meetDate               DateTime? @map("meet_date") @db.Date
  distance               Float?
  distanceLabel          String?   @map("distance_label")
  participantCount       Int?      @map("participant_count")
  maleParticipantCount   Int?      @map("male_participant_count")
  femaleParticipantCount Int?      @map("female_participant_count")
  averageTime            Float?    @map("average_time")
  averagePace            Float?    @map("average_pace")
  bestTime               Float?    @map("best_time")
  bestAthleteId          String?   @map("best_athlete_id") @db.Uuid
  teamScore              Float?    @map("team_score")
  boysAvgPace            Float?    @map("boys_avg_pace")
  boysCount              Int?      @map("boys_count")
  girlsAvgPace           Float?    @map("girls_avg_pace")
  girlsCount             Int?      @map("girls_count")
  metrics                Json?
  calculatedAt           DateTime  @default(now()) @map("calculated_at")

  race        Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  bestAthlete Athlete? @relation("BestAthlete", fields: [bestAthleteId], references: [id], onDelete: SetNull)

  @@unique([raceId, teamId])
  @@index([teamId])
  @@index([raceId])
  @@map("meet_performance_metrics")
}

// ---------------------------------------------------------------------------
// Product feedback
//
// Captured in-app rather than out-of-band: the context that makes a report
// actionable (which screen, which season, what the console said) is exactly
// the context a person is least likely to write down by hand.
//
// Deliberately not linked by foreign key to User/Team — feedback must survive
// the thing it is about being deleted, and a report about a broken team should
// not disappear when that team is cleaned up.
// ---------------------------------------------------------------------------
model Feedback {
  id        String  @id @default(uuid()) @db.Uuid
  teamId    String? @map("team_id") @db.Uuid
  userId    String? @map("user_id") @db.Uuid
  userEmail String? @map("user_email")
  userRole  String? @map("user_role")

  /// Route the reporter was on, e.g. "/analytics"
  route  String
  /// Human label for that route, e.g. "Analytics — Dashboard"
  screen String?
  /// Season selected at the time; a lot of bugs are season-dependent.
  season Int?

  /// blocker | bug | polish | idea
  severity String @default("bug")
  message  String
  /// Console errors, viewport, user agent — auto-captured.
  context  Json?

  /// open | triaged | fixed | wontfix
  status String  @default("open")
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teamId])
  @@index([status])
  @@map("feedback")
}

// ---------------------------------------------------------------------------
// T6 (Team Management handoff): equipment and uniform checkout. "Fully
// separable. Build whenever there is a gap." The feature that justifies
// the build is the season-end outstanding report (GET /equipment/outstanding
// in routes/equipment.js) — every unreturned item grouped by athlete.
// ---------------------------------------------------------------------------

// Four categories, matching what a coach actually tracks on paper — see
// migration 20260816020000_equipment_categories for the consolidation from
// an earlier 7-category version (uniform/warmup top+bottom split, bag).
enum EquipmentType {
  TOP
  BOTTOM
  SPIKES
  OTHER
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  POOR
  RETIRED
}

model Equipment {
  id         String             @id @default(uuid()) @db.Uuid
  teamId     String             @map("team_id") @db.Uuid
  type       EquipmentType
  identifier String // jersey number or asset tag
  size       String?
  condition  EquipmentCondition @default(GOOD)
  retired    Boolean            @default(false)
  notes      String?

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignments EquipmentAssignment[]

  @@unique([teamId, type, identifier])
  @@map("equipment")
}

// "An item is out when an assignment row exists with returnedAt null.
// Enforce one active assignment per item." Application code checks this
// before creating a row (routes/equipment.js), but the real guarantee
// against two coaches checking out the same item at once is a DB-level
// partial unique index on (equipment_id) WHERE returned_at IS NULL —
// Prisma's schema language can't express a WHERE clause on an @@index/
// @@unique, so that constraint exists ONLY in the migration SQL
// (20260811040000_equipment/migration.sql), not here. Don't remove it
// there without adding an equivalent guard.
model EquipmentAssignment {
  id             String              @id @default(uuid()) @db.Uuid
  equipmentId    String              @map("equipment_id") @db.Uuid
  athleteId      String              @map("athlete_id") @db.Uuid
  seasonId       String              @map("season_id") @db.Uuid
  checkedOutAt   DateTime            @map("checked_out_at")
  checkedOutById String?             @map("checked_out_by") @db.Uuid
  dueDate        DateTime?           @map("due_date") @db.Date
  returnedAt     DateTime?           @map("returned_at")
  returnedById   String?             @map("returned_by") @db.Uuid
  conditionOut   EquipmentCondition? @map("condition_out")
  conditionIn    EquipmentCondition? @map("condition_in")
  notes          String?

  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  athlete      Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  season       Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  checkedOutBy User?     @relation("EquipmentCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  returnedBy   User?     @relation("EquipmentReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([athleteId, seasonId])
  @@index([equipmentId, returnedAt])
  @@map("equipment_assignments")
}
