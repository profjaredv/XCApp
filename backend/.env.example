# Neon Postgres — from your Neon project dashboard.
# DATABASE_URL should be the pooled ("-pooler") connection string;
# DIRECT_URL should be the direct (non-pooled) one, used only for
# `prisma migrate`.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/xcapp?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/xcapp?sslmode=require

# Neon Auth (Better Auth under the hood) — the JWKS URL shown on your Neon
# project's Auth tab. It's served from your project's own Neon endpoint:
# https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth/.well-known/jwks.json
NEON_AUTH_JWKS_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/your-database/auth/.well-known/jwks.json

# Same Neon project's "Auth URL" (same Auth tab, different field — no
# /.well-known/jwks.json suffix). This is where /api/auth-proxy forwards
# requests to (see lib/authProxy.js) so the frontend's VITE_NEON_AUTH_URL
# can point at this app's own domain instead of Neon's directly — the fix
# for Safari/iPadOS silently blocking the session cookie on a cross-site
# sign-in call. Required for sign-in to work at all once VITE_NEON_AUTH_URL
# is switched to the proxy path.
NEON_AUTH_UPSTREAM_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/your-database/auth

# Cloudflare R2 — LeadPack Photos' image storage (see lib/r2.js and
# docs/leadpack-photos-build-spec.md). One private bucket, no public access.
# Create it in the Cloudflare dashboard (R2 > Create bucket), then add a
# CORS rule allowing GET and PUT from this app's origin(s): PUT so the
# browser can upload directly, GET so the Build module's <canvas> EXPORT
# (web/src/pages/photos/lib/collageRender.ts's requireExportableCanvas
# path, which loads images with crossOrigin="anonymous") doesn't throw a
# SecurityError on canvas.toDataURL(). The on-screen collage PREVIEW
# doesn't set crossOrigin at all and works with no CORS rule — only
# clicking "Export PNG" needs GET allowed, and it now fails with a clear
# error naming the problem if that rule is missing, instead of silently
# producing a blank page. Access keys: R2 > Manage API tokens > Create API
# token, scoped to this bucket only — never the account-wide default
# token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: enables the AI insights feature in Coaches Tools. Leave unset
# to disable that feature rather than fall back to a shared key — a
# hardcoded key was previously committed here, see MIGRATION_STATUS.md.
GEMINI_API_KEY=

# Optional: Redis-backed metrics cache. Falls back to "no cache" if unset.
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

PORT=3001
NODE_ENV=development

# Optional. Comma-separated email allowlist for platform super-admin
# (cross-team view/edit, see lib/superAdmin.js). Leave unset to disable
# entirely — matches nothing, no accounts are ever granted this by default.
SUPER_ADMIN_EMAILS=

# Optional. Comma-separated list of origins the API accepts
# cross-origin requests from in production (see server.js). Leave unset
# to use the built-in default (leadpack.cc, www.leadpack.cc, and the
# original Railway subdomain). Only needs setting if you add another
# domain later.
# ALLOWED_ORIGINS=https://leadpack.cc,https://www.leadpack.cc

# Optional: sends staff-invite emails via eusend.dev (see lib/email.js).
# Leave unset to disable — the invite still gets created, the head coach
# just has to copy/send the link themselves (existing frontend fallback).
# The `from` address's domain must be verified in the eusend dashboard
# (SPF/DKIM/DMARC) or sends are rejected — ours is mail.leadpack.cc, not
# the apex leadpack.cc, so EUSEND_FROM_EMAIL must stay on that subdomain
# unless you verify a different domain.
EUSEND_API_KEY=
# EUSEND_FROM_EMAIL=LeadPack XC <run@mail.leadpack.cc>

# Optional. Base URL used to build the link inside invite emails (e.g.
# https://www.leadpack.cc/staff-invite/<token>). Leave unset to default to
# https://www.leadpack.cc in production and http://localhost:5173 in dev —
# the apex leadpack.cc has no DNS record pointed at the app, so it must be
# the www subdomain unless that DNS gap gets fixed.
# FRONTEND_URL=https://www.leadpack.cc
