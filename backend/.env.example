# Neon Postgres — from your Neon project dashboard.
# DATABASE_URL should be the pooled ("-pooler") connection string;
# DIRECT_URL should be the direct (non-pooled) one, used only for
# `prisma migrate`.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/xcapp?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/xcapp?sslmode=require

# Neon Auth (Stack) — both values are on the same Neon project's Auth tab.
# STACK_JWKS_URL is the full JWKS URL shown there — it's served from your
# project's own Neon endpoint, not a shared api.stack-auth.com host:
# https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth/.well-known/jwks.json
STACK_PROJECT_ID=your-stack-project-id
STACK_JWKS_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/your-database/auth/.well-known/jwks.json

# Shared secret a user enters to self-upgrade to a coach role.
# Generate a real random value — do not reuse any value that was ever
# committed to this repo (see MIGRATION_STATUS.md).
COACH_UPGRADE_CODE=

# Optional: enables the AI insights feature in Coaches Tools. Leave unset
# to disable that feature rather than fall back to a shared key — a
# hardcoded key was previously committed here, see MIGRATION_STATUS.md.
GEMINI_API_KEY=

# Optional: Redis-backed metrics cache. Falls back to "no cache" if unset.
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

PORT=3001
NODE_ENV=development
